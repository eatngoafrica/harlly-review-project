# Copy this file to .env and fill in real values. Never commit .env.

# Your business ID in Harlyy
HARLYY_BUSINESS_ID=

# Option 1: paste an access token you already have
HARLYY_ACCESS_TOKEN=

# Option 2: OAuth client credentials from
# https://www.harlyy.com/dashboard/developers/credentials
HARLYY_CLIENT_ID=
HARLYY_CLIENT_SECRET=

# Optional: comma-separated survey IDs (default: all surveys)
HARLYY_SURVEY_IDS=
